{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ray-manaloto/knowledge-base/schemas/research-record.schema.json",
  "title": "AdapterRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "tier",
    "question",
    "command",
    "trackers",
    "links",
    "packages",
    "ran_at",
    "total_count",
    "hits",
    "null_result"
  ],
  "properties": {
    "adapter": {"type": "string"},
    "tier": {"$ref": "#/$defs/Tier"},
    "question": {"type": "string", "minLength": 1, "maxLength": 512},
    "command": {"type": "string", "minLength": 1, "maxLength": 1024},
    "trackers": {
      "anyOf": [
        {"$ref": "#/$defs/Trackers"},
        {"type": "null"}
      ]
    },
    "links": {
      "anyOf": [
        {"$ref": "#/$defs/Links"},
        {"type": "null"}
      ]
    },
    "packages": {
      "anyOf": [
        {"$ref": "#/$defs/Packages"},
        {"type": "null"}
      ]
    },
    "ran_at": {"$ref": "#/$defs/UtcTimestamp"},
    "total_count": {"type": "integer", "minimum": 0},
    "hits": {
      "type": "array",
      "maxItems": 60,
      "items": {"$ref": "#/$defs/Hit"}
    },
    "null_result": {
      "anyOf": [
        {"$ref": "#/$defs/Null"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "Tier": {
      "type": "string",
      "enum": ["cheap", "expensive"]
    },
    "Kind": {
      "type": "string",
      "enum": ["issue", "pr", "package"]
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "Hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "snippet", "date", "kind"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "title": {"type": "string", "minLength": 0, "maxLength": 512},
        "snippet": {"type": "string", "minLength": 0, "maxLength": 600},
        "date": {"$ref": "#/$defs/UtcTimestamp"},
        "kind": {"$ref": "#/$defs/Kind"}
      }
    },
    "Arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "result", "discriminates"],
      "properties": {
        "kind": {"$ref": "#/$defs/Kind"},
        "command": {"type": "string", "minLength": 1, "maxLength": 1024},
        "result": {"type": "string"},
        "discriminates": {"type": "boolean"}
      }
    },
    "Null": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms"],
      "properties": {
        "arms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/Arm"}
        }
      }
    },
    "Trackers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_issues", "has_discussions"],
      "properties": {
        "has_issues": {"type": "boolean"},
        "has_discussions": {"type": "boolean"}
      }
    },
    "Links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "broken_count", "results"],
      "properties": {
        "checked": {"type": "integer", "minimum": 0},
        "broken_count": {"type": "integer", "minimum": 0},
        "results": {
          "type": "array",
          "maxItems": 60,
          "items": {"$ref": "#/$defs/LinkResult"}
        }
      }
    },
    "LinkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "ok", "status_text"],
      "properties": {
        "url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "ok": {"type": "boolean"},
        "status_text": {"type": "string", "maxLength": 200},
        "status_details": {"type": ["string", "null"], "maxLength": 600},
        "line": {"type": ["integer", "null"]},
        "column": {"type": ["integer", "null"]},
        "duration_ms": {"type": ["number", "null"]}
      }
    },
    "Packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "name",
        "version_count",
        "latest_version",
        "licenses",
        "direct_dependency_count",
        "cited_links"
      ],
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 40},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version_count": {"type": "integer", "minimum": 0},
        "latest_version": {
          "anyOf": [
            {"type": "string", "maxLength": 100},
            {"type": "null"}
          ]
        },
        "licenses": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 100}
        },
        "direct_dependency_count": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "cited_links": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 2048}
        }
      }
    }
  }
}
