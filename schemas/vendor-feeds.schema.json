{
  "type": "object",
  "properties": {
    "vendors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VendorFeed"
      }
    },
    "resolved_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin_options": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "disabled_by_baseline": {
      "type": "boolean"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "vendors",
    "resolved_model",
    "plugin_options",
    "disabled_by_baseline",
    "overrides"
  ],
  "additionalProperties": false,
  "title": "Feeds",
  "$defs": {
    "FeedStatus": {
      "title": "FeedStatus",
      "type": "string",
      "enum": [
        "live",
        "bundled",
        "unreadable",
        "shape_broken"
      ]
    },
    "VendorFeed": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/FeedStatus"
        },
        "slugs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "efforts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "retirements": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "upgrades": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "display_names": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "duration_s": {
          "type": "number"
        },
        "hidden_slugs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "status",
        "slugs",
        "findings",
        "efforts",
        "retirements",
        "upgrades",
        "display_names",
        "duration_s",
        "hidden_slugs"
      ],
      "additionalProperties": false
    },
    "ReasoningLevel": {
      "type": "object",
      "properties": {
        "effort": {
          "type": "string"
        }
      },
      "required": [
        "effort"
      ],
      "additionalProperties": false
    },
    "Upgrade": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "retirement_at": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "retirement_at"
      ],
      "additionalProperties": false
    },
    "CodexModel": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "upgrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/Upgrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_reasoning_levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReasoningLevel"
          }
        }
      },
      "required": [
        "slug",
        "visibility",
        "upgrade",
        "supported_reasoning_levels"
      ],
      "additionalProperties": false
    },
    "CodexCatalog": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodexModel"
          }
        }
      },
      "required": [
        "models"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
