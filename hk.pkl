amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"

// Builtin linters MUST be assigned from Builtins (`= Builtins.name`), never a
// bare `["name"] {}` block — a bare block is a fresh empty Step that hk silently
// skips. See ray-manaloto/dotfiles feedback_hk_builtins_need_assignment.
import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

// Refuse this config on an older hk binary rather than silently misreading it.
min_hk_version = "1.49.0"

// Zero-skip: report ALL issues, not just the first.
fail_fast = false

// Non-source paths excluded from every builtin.
exclude = List(
  "graphify-out/**",
  "sources/**",
  "raw/**",
  // Promoted agent reports, kept VERBATIM (`agent-report-persistence.md`).
  // rumdl and the whitespace builtins want to rewrite them — trailing `.` off a
  // heading, an EOF newline — and every such edit alters the record the rule
  // exists to preserve. They are archived research, not authored docs, which is
  // the same category `sources/**` above is excluded for and the same carve-out
  // `.agnix.toml` already makes. Not a suppressed finding: nothing here is a
  // defect in this repo's own source.
  "docs/research/**",
  // The `/goal` PAYLOAD — the exact text pasted after `/goal `, so its bytes ARE
  // the artifact (`docs/goals/README.md`). Same category as the line above, one
  // step further: a formatter edit here does not just alter a record, it alters a
  // live instruction to an agent. Measured: rumdl wants an H1 on line 1 (MD041),
  // then objects that the heading ends in `.` (MD026), and `rumdl fmt` would strip
  // that period off `Headline word: Legible.` — silently rewriting the condition.
  // Adding an H1 to satisfy it also prepends `# ` to whatever gets pasted.
  // Approved by Ray, 2026-07-27, over the two alternatives (fence the condition in
  // a code block, which breaks `wc -c` against the 4,000-char cap; or accept the
  // formatter shaping the payload). Scoped to `*-goal.md` ONLY — the `-rider.md`
  // half and `README.md` are ordinary authored docs and stay fully linted.
  "docs/goals/*-goal.md",
  "**/.venv/**",
  "**/__pycache__/**",
  "**/*.lock",
)

// Toolset — most efficient/optimized tool per job; rust-native preferred, Go/others
// fine when they're the best option (Ray, 2026-07-22):
//   Python  ruff + ty        (rust)   — strict `select=ALL`; config in the single
//                                       repo-root pyproject.toml, so `uv run` (no
//                                       --project) governs BOTH python/src and tests/.
//   TOML    taplo(_format)    (rust)
//   Markdown rumdl(_format)   (rust)   — rumdl_format is the hk 1.52 (#1080) formatter
//                                       half, mirroring the ruff/taplo lint+fmt split.
//   Spelling typos            (rust)
//   Secrets gitleaks         (go)     — the standard, well-optimized scanner.
//   Pkl      pkl              (pkl CLI)
//   Hygiene  hk util builtins (rust, in the hk binary — no external tool)
// ruff/ruff_format/ty are CUSTOM shell-string steps: hk 1.51+ (#1067) moved the ruff
// builtins to structured `argv`, which "can't be combined with `shell`/`prefix`" — so
// `(Builtins.ruff){prefix=…}` panics. A string check/fix carries the `uv run` prefix.
// Order per Astral docs: `ruff check --fix` BEFORE `ruff format`; `exclusive` (a
// barrier), NOT `depends` (a failed dep deadlocks hk — dotfiles #268). taplo/rumdl and
// the hygiene builtins are on PATH via mise (HK_MISE=1), so they need no prefix.
local pyGlob = List("python/src/**/*.py", "tests/**/*.py")

local lintSteps: Mapping<String, Step> = new {
  ["typos"] = Builtins.typos
  ["gitleaks"] = Builtins.gitleaks
  ["pkl"] = Builtins.pkl
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = Builtins.taplo_format
  ["rumdl"] = Builtins.rumdl
  ["rumdl_format"] = Builtins.rumdl_format
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["detect_private_key"] = Builtins.detect_private_key
  ["check_added_large_files"] = Builtins.check_added_large_files
  ["ruff"] = new Step {
    glob = pyGlob
    check = "uv run ruff check {{files}}"
    fix = "uv run ruff check --fix {{files}}"
  }
  ["ruff_format"] = new Step {
    glob = pyGlob
    check = "uv run ruff format --check {{files}}"
    fix = "uv run ruff format {{files}}"
    exclusive = true
  }
  ["ty"] = new Step {
    glob = pyGlob
    check = "uv run ty check python/src tests"
  }
  // Zero inline suppressions: all suppressions live in the ONE pyproject.toml as
  // per-file-ignores, never inline noqa/type:ignore/ty:ignore in source. Logic in
  // kb_setup.lint_checks (zero-bash-logic — no inline shell in hk.pkl).
  ["no_lint_skip"] = new Step {
    glob = pyGlob
    check = "uv run kb-setup no-lint-skip"
  }

  // --- Agent documentation (agnix) ---
  //     --strict: warnings-as-errors. agnix exits 0 on warnings-only, so
  //     without it every warning is invisible (dotfiles #250). Parity with
  //     `mise run lint-docs`. Known false positives + by-design patterns are
  //     scoped in .agnix.toml. settings.json is in the glob so a hook-config
  //     change triggers agnix locally — it is the file agnix most often flags.
  ["agnix"] = new Step {
    check = "agnix . --strict"
    glob = List(
      "CLAUDE.md",
      ".claude/**/*.md",
      ".claude/settings.json",
      ".agnix.toml",
    )
  }

  // --- Markdown instruction-file budgets, BY LOAD CLASS ---
  //     The ONE documented figure is "target under 200 lines per CLAUDE.md
  //     file" (code.claude.com/docs/en/memory § Write effective instructions)
  //     — a SOFT guideline about a gradient, NOT a truncation point ("CLAUDE.md
  //     files are loaded in full regardless of length").
  //
  //     Budgets differ by LOAD CLASS because that is the docs' own cost model
  //     — what matters is WHEN the bytes are spent:
  //       eager (root CLAUDE.md + @import closure; .claude/CLAUDE.md; unscoped
  //         .claude/rules/*, at "the same priority as .claude/CLAUDE.md") → 200
  //       lazy  (nested CLAUDE.md: "included when Claude reads files in those
  //         subdirectories", not re-injected on /compact)                 → 400
  //       cond  (paths:-scoped rules: load "only when Claude works with
  //         matching files")                                              → 400
  //       skill (SKILL.md: "Keep under 500 lines")                        → 500,
  //         plus description ≤ 1536 chars — a REAL hard truncation that
  //         silently strips the keywords Claude matches on.
  //     The byte ceilings are SELF-IMPOSED anti-gaming backstops, sized never
  //     to bind before the documented line limit. Do not re-attribute them
  //     upstream: the ≤12,000-char figure is WINDSURF's (agnix AGM-003), and
  //     citing it as Anthropic's is the error this step replaced.
  //
  //     Logic lives in kb_setup.md_budget (zero-bash) — the SHARED engine
  //     dotfiles also consumes, on the kb_setup.currency precedent.
  ["md_size_budget"] = new Step {
    check = "uv run kb-setup md-budget"
  }
}

hooks {
  ["check"] {
    steps = lintSteps
  }
  ["fix"] {
    fix = true
    steps = lintSteps
  }
  ["pre-commit"] {
    fix = true
    steps = lintSteps
  }
  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
    }
  }
}
