amends "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Config.pkl"

// Builtin linters MUST be assigned from Builtins (`= Builtins.name`), never a
// bare `["name"] {}` block — a bare block is a fresh empty Step that hk silently
// skips. See ray-manaloto/dotfiles feedback_hk_builtins_need_assignment.
import "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Builtins.pkl"

// Refuse this config on an older hk binary rather than silently misreading it.
min_hk_version = "1.49.0"

// Zero-skip: report ALL issues, not just the first.
fail_fast = false

// Non-source paths excluded from every builtin.
//
// `graphify-out/memory/**` is deliberately NOT here — see `proseExclude` below,
// which is where it is excluded from the FORMATTERS only. A per-step `exclude`
// REPLACES this list rather than extending it (hk `Config.pkl:99`), so the two
// are composed explicitly.
local baseExclude = List(
  // NOT the whole of `graphify-out/` — `memory/` is the ONE committed
  // subdirectory of it, and excluding it here strips those files from
  // `{{ files }}` for every builtin, including the secret scanners.
  //
  // That mattered: on 2026-07-28 a `kb-remember` note landed with three live
  // tokens in it and `gitleaks` went green. `.gitleaks.toml`'s own allowlist was
  // half the cause and is fixed; this line was the other half, and fixing only
  // the first left the coverage resting on an accident — `gitleaks dir` IGNORES
  // its path arguments once there is more than one (measured: 1 arg → 5.01 KB
  // scanned, 2 args → 8.62 MB, flagging a token in a path named by neither), so
  // it happened to scan the whole tree anyway. Builtins that DO honour the file
  // list were correspondingly blind — `detect_private_key` flagged a planted
  // control under `docs/` and not the identical file under
  // `graphify-out/memory/`. A gitleaks release that starts honouring its args
  // would have silently removed the only tool coverage these paths have.
  //
  // Load-bearing for `kb_setup.review.EXEMPT_PATHS`: a commit whose whole delta
  // is `graphify-out/memory/**` ships on an ancestor's receipt, so no review
  // lane reads it either. (Silent-failure lane, round 2.)
  // ENUMERATED BY NAME, and neither of the two obvious spellings works —
  // measured, not assumed, each with a planted file under `graphify-out/memory/`
  // and a control under `docs/`:
  //   `graphify-out/!(memory)/**` → passes `hk validate`, still excludes
  //     `memory/` (count stayed 172; the `docs/` control moved it to 173).
  //     hk's globs are not extglob.
  //   `graphify-out/*.*` → excludes `memory/` too, because **hk's `*` CROSSES
  //     `/`**. Replacing that one line with the names below moved the count
  //     172 → 212, i.e. it had been hiding all 38 committed work-memory files.
  //     Any extension pattern (`graphify-out/*.md`) has the same defect.
  // So: literal names for the derived top-level artifacts, `**` for the derived
  // subdirectories. A new derived artifact that is not listed just gets linted —
  // noise, which is the failure direction to prefer over blindness.
  // graphify's ATOMIC-WRITE temp files are NOT here — they are formatter-only,
  // in `proseExclude` below. Putting them in this list was the 2026-08-08 fix's
  // first form and it re-made the exact mistake the paragraph below records.
  "graphify-out/GRAPH_REPORT.md",
  "graphify-out/GRAPH_TREE.html",
  "graphify-out/graph.json",
  "graphify-out/graph-prose.json",
  "graphify-out/graph.graphml",
  "graphify-out/graph.svg",
  "graphify-out/knowledge-base-callflow.html",
  "graphify-out/manifest.json",
  "graphify-out/cypher.txt",
  "graphify-out/cache/**",
  "graphify-out/converted/**",
  "graphify-out/obsidian/**",
  "graphify-out/reflections/**",
  "graphify-out/transcripts/**",
  "graphify-out/wiki/**",
  "graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/**",
  "sources/**",
  "raw/**",
  // `docs/research/**` and `docs/goals/*-goal.md` USED TO SIT HERE, on a
  // rationale that is entirely about FORMATTERS — see `proseExclude`, which is
  // where they moved. Both are now excluded from the rewriters and visible to
  // the scanners, which is the same split `graphify-out/memory/**` got.
  //
  // Leaving them here was the identical defect one path over, and it survived
  // the round that fixed the other: a formatter's reason ("do not rewrite the
  // record") was written into the list that ALSO governs gitleaks and
  // `detect_private_key`.
  //
  // State the effect precisely, because the two scanners differ. Builtins that
  // HONOUR the file list — `detect_private_key`, `check_added_large_files` —
  // were genuinely blind to both paths. gitleaks was not, but only by accident:
  // `gitleaks dir` IGNORES its path arguments once there is more than one
  // (measured last round: 1 arg → 5.01 KB, 2 args → 8.62 MB), so it scanned the
  // whole tree regardless of what hk handed it. A release that starts honouring
  // those args would have silently removed that coverage — which is the same
  // reason `graphify-out/memory/**` was moved rather than left resting on it.
  //
  // Measured 2026-07-28: moving these two moved hk's file list 215 → 234, i.e.
  // exactly the 18 tracked `docs/research` files plus the one `*-goal.md`.
  // `.gitleaks.toml` allowlists neither path, and both are clean today, so this
  // costs zero noise. Control-armed both ways: a planted token in each
  // directory is found, and the same scan of the real content reports nothing.
  "**/.venv/**",
  "**/__pycache__/**",
  "**/*.lock",
)

exclude = baseExclude

// The FORMATTERS' exclude, and only theirs. `graphify-out/memory/**` is
// generated by `graphify save-result` (via `kb-remember`), so it is a record of
// what a session concluded — the same category as `docs/research/**` and
// `docs/goals/*-goal.md` above, and reformatting it edits the record. It is also
// regenerated in that same shape on every ingestion, so a formatter that fixed
// the 38 existing files would fail again on the next one, forever.
//
// The SCANNERS deliberately do NOT get this list. That asymmetry is the entire
// point: `kb_setup.review.EXEMPT_PATHS` lets a commit whose whole delta is
// `graphify-out/memory/**` ship on an ancestor's receipt, so no review lane
// reads those files — and on 2026-07-28 one of them arrived carrying three live
// credentials. Style is not worth editing a record for; a secret is worth
// finding. Splitting these two is what lets both be true.
// `docs/research/**` — promoted agent reports, kept VERBATIM
// (`agent-report-persistence.md`). rumdl and the whitespace builtins want to
// rewrite them (a trailing `.` off a heading, an EOF newline) and every such
// edit alters the record the rule exists to preserve. Archived research, not
// authored docs — the same category `sources/**` is excluded for, and the same
// carve-out `.agnix.toml` already makes.
//
// `docs/goals/*-goal.md` — the `/goal` PAYLOAD, the exact text pasted after
// `/goal `, so its bytes ARE the artifact (`docs/goals/README.md`). One step
// further than the line above: a formatter edit here does not just alter a
// record, it alters a live instruction to an agent. Measured: rumdl wants an H1
// on line 1 (MD041), then objects that the heading ends in `.` (MD026), and
// `rumdl fmt` would strip that period off `Headline word: Legible.` — silently
// rewriting the condition. Adding an H1 also prepends `# ` to whatever gets
// pasted. Approved by Ray, 2026-07-27, over the two alternatives (fence the
// condition in a code block, which breaks `wc -c` against the 4,000-char cap;
// or accept the formatter shaping the payload). Scoped to `*-goal.md` ONLY —
// the `-rider.md` half and `README.md` are ordinary authored docs.
// `docs/direction/**` — VERBATIM records of what Ray asked for, captured at a
// `/clear-prep` so the instructions survive a `/clear`. Same category as the
// three above: the bytes ARE the artifact, and a spell-checker "fixing" them
// edits a record of what someone said rather than a doc someone authored.
// Measured on the first such file: `typos` rejected a misspelling of
// "hierarchy" sitting inside a direct quote — a real typo, which is exactly the
// thing that must not be silently corrected when the sentence is someone's
// words. (Do not quote the misspelling itself here: `hk.pkl` is NOT on this
// list, so naming it re-breaks this very step — measured, once.)
// Approved by Ray, 2026-08-02, over the alternative of editing the
// quote. FORMATTERS ONLY, per the asymmetry above — gitleaks and the other
// scanners still read these files, which matters because nothing else does:
// a direction doc is authored outside any review lane.
// graphify writes ATOMICALLY, and the helper is GENERIC: `graphify/paths.py`
//   fd, tmp = tempfile.mkstemp(dir=…, prefix=f".{real.name}.", suffix=".tmp")
// so EVERY atomic write lands as `.<destination name>.<random>.tmp` and is then
// renamed — not just the graph. A `mise run fmt` overlapping a `kb-build`
// picked one up and `hk fix` WEDGED for 3h06m at 0.0% CPU appending a trailing
// newline to a ~499 MB JSON that then vanished under it, spinning on
// `failed to canonicalize file: … No such file or directory`. Measured
// 2026-08-08; the graph survived (357,217 nodes), but hk has no timeout of its
// own, so nothing would ever have aborted it.
//
// THREE things about this entry, each one a wrong version that shipped first:
//
// 1. It is FORMATTER-ONLY. The wedge was `newlines`, a formatter, so this
//    belongs here and not in `baseExclude` — which is also what `gitleaks`,
//    `detect_private_key`, `check_merge_conflict` and `check_added_large_files`
//    run with. Armed with a planted private key at `graphify-out/.graphARM.md`:
//    in `baseExclude` -> `detect_private_key` never ran on it, rc=0 (BLIND);
//    here -> flagged, rc=1. Control: the same file under `docs/` -> rc=1, so
//    the probe discriminates. (`.env` is NOT a control — that extension never
//    reaches the step, which is a probe that cannot answer, not a pass.)
// 2. The shape is `.*.tmp`, NOT `.graph*`. Measured with two planted 1-byte
//    files: `.graph.json.ARM.tmp` excluded, but `.manifest.json.ARM.tmp` was
//    rewritten 1 -> 2 bytes — so `.graph*` left the wedge live for every atomic
//    write that is not the graph (manifest.json, cypher.txt, …).
// 3. It is `**/`-rooted. `brain-update` runs `graphify update .` in `brain/`
//    (mise.toml), and `python/` and `tests/` get their own trees too — the same
//    helper, the same hazard, and `brain/graphify-out/.graph.json.<rand>.tmp`
//    is not gitignored either. A root-anchored pattern fixed one tree of four.
//
// Findings 1 and 3 are the cold lane's, rounds 1 and 2.
local proseExclude = baseExclude
  + List("graphify-out/memory/**", "docs/research/**", "docs/goals/*-goal.md", "docs/direction/**",
      "docs/session-review/runs/**",
      "sources/**",
      "**/graphify-out/.*.tmp")
// `docs/session-review/runs/**` — the promoted output of a session-review run:
// per-lane reports, refutation reports and the synthesis, kept VERBATIM as the
// evidence behind the issues they produced. Same argument as `docs/research/**`
// and `docs/direction/**` above: a formatter or spell-checker "fixing" one of
// these edits what an agent actually reported, and these files are cited by
// issue number, so a reader following the citation must find what was written.
//
// FORMATTERS AND typos ONLY, per the asymmetry this whole list rests on:
// gitleaks, `detect_private_key`, `check_merge_conflict` and
// `check_added_large_files` still read every one of them. That matters more
// here than for most entries — these files quote transcripts, commands and
// `gh api` output, so they are a plausible place for a token to land.
//
// Scoped to `runs/**` rather than `docs/session-review/**`, deliberately: the
// generated landing index at that directory's root is OUR file, machine-written
// and reviewable, so it stays formatted like every other doc.
// `sources/**` — approved by Ray, 2026-08-17, over the narrower
// `sources/extractions/**`. FORMATTERS AND typos ONLY, per the asymmetry above:
// gitleaks, `detect_private_key` and the structural checks still read every one
// of these files, which is what keeps an exclusion this wide tolerable.
//
// The measurement that prompted it: `typos` reports 618 errors across 8
// committed extraction chunks, and every one is a node-ID fragment rather than
// prose — one three-letter source prefix accounts for 430 of them on its own,
// and four fragments cover 607. THE TOKENS ARE NOT NAMED HERE, and that is not
// coyness: `hk.pkl` is not on this list, so writing them re-breaks this very
// step. The warning above says so, and this comment's first draft did it anyway
// — measured, twice now. Read the offenders from `typos sources/` instead.
// Editing them is not available: `sources/**`
// records what a source said at ingestion time, and
// `agent-artifact-conventions.md` forbids rewriting corpus content to satisfy a
// linter, because the provenance a manifest guarantees is the thing being
// falsified.
//
// WIDER THAN THE FAILURE, deliberately. `sources/extractions/**` would have
// cleared today's red and left the next source type to rediscover it: a chunk is
// generated, a vendored transcript is someone else's words, and a manifest is a
// pinned fact — none of the three is ours to correct. The cost is real and worth
// stating rather than discovering: `sources/media/` transcripts ARE prose a
// spell-checker could legitimately help with, and they are no longer checked.
//
// The alternative — teaching `typos` that those four fragments are words — was
// rejected as recurring by construction: it is a repo-wide vocabulary change
// made to satisfy one generated file, and the next extraction round invents new
// identifiers.

// Toolset — most efficient/optimized tool per job; rust-native preferred, Go/others
// fine when they're the best option (Ray, 2026-07-22):
//   Python  ruff + ty        (rust)   — strict `select=ALL`; config in the single
//                                       repo-root pyproject.toml, so `uv run` (no
//                                       --project) governs BOTH python/src and tests/.
//   TOML    taplo(_format)    (rust)
//   Markdown rumdl(_format)   (rust)   — rumdl_format is the hk 1.52 (#1080) formatter
//                                       half, mirroring the ruff/taplo lint+fmt split.
//   Spelling typos            (rust)
//   Secrets gitleaks         (go)     — the standard, well-optimized scanner.
//   Pkl      pkl              (pkl CLI)
//   Hygiene  hk util builtins (rust, in the hk binary — no external tool)
// ruff/ruff_format/ty are CUSTOM shell-string steps: hk 1.51+ (#1067) moved the ruff
// builtins to structured `argv`, which "can't be combined with `shell`/`prefix`" — so
// `(Builtins.ruff){prefix=…}` panics. A string check/fix carries the `uv run` prefix.
// Order per Astral docs: `ruff check --fix` BEFORE `ruff format`; `exclusive` (a
// barrier), NOT `depends` (a failed dep deadlocks hk — dotfiles #268). taplo/rumdl and
// the hygiene builtins are on PATH via mise (HK_MISE=1), so they need no prefix.
// `ruff_format` is declared at the BOTTOM of `lintSteps`, far from `ruff` — that
// separation is measured and deliberate; see the comment on the step itself before
// moving it back up. The `depends` note above still stands as the reason it is a
// barrier at all; the note below is the reason for WHERE the barrier sits.
local pyGlob = List("python/src/**/*.py", "tests/**/*.py")

local lintSteps: Mapping<String, Step> = new {
  // Formatters and spell-checkers: `proseExclude`, so they never rewrite a
  // generated work-memory record.
  ["typos"] = (Builtins.typos) { exclude = proseExclude }
  ["rumdl"] = (Builtins.rumdl) { exclude = proseExclude }
  ["rumdl_format"] = (Builtins.rumdl_format) { exclude = proseExclude }
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) { exclude = proseExclude }
  ["newlines"] = (Builtins.newlines) { exclude = proseExclude }
  ["mixed_line_ending"] = (Builtins.mixed_line_ending) { exclude = proseExclude }
  // Scanners and structural checks: the DEFAULT exclude, so `graphify-out/memory/**`
  // stays visible to them. Do not "tidy" these onto `proseExclude`.
  ["gitleaks"] = Builtins.gitleaks
  ["detect_private_key"] = Builtins.detect_private_key
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_added_large_files"] = Builtins.check_added_large_files
  ["pkl"] = Builtins.pkl
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = Builtins.taplo_format
  ["ruff"] = new Step {
    glob = pyGlob
    check = "uv run ruff check {{files}}"
    fix = "uv run ruff check --fix {{files}}"
  }
  ["ty"] = new Step {
    glob = pyGlob
    check = "uv run ty check python/src tests"
  }
  // Zero inline suppressions: all suppressions live in the ONE pyproject.toml as
  // per-file-ignores, never inline noqa/type:ignore/ty:ignore in source. Logic in
  // kb_setup.lint_checks (zero-bash-logic — no inline shell in hk.pkl).
  ["no_lint_skip"] = new Step {
    glob = pyGlob
    check = "uv run kb-setup no-lint-skip"
  }

  // --- Agent documentation (agnix) ---
  //     --strict: warnings-as-errors. agnix exits 0 on warnings-only, so
  //     without it every warning is invisible (dotfiles #250). Parity with
  //     `mise run lint-docs`. Known false positives + by-design patterns are
  //     scoped in .agnix.toml. settings.json is in the glob so a hook-config
  //     change triggers agnix locally — it is the file agnix most often flags.
  ["agnix"] = new Step {
    check = "agnix . --strict"
    glob = List(
      "CLAUDE.md",
      ".claude/**/*.md",
      ".claude/settings.json",
      ".agnix.toml",
    )
  }

  // --- Markdown instruction-file budgets, BY LOAD CLASS ---
  //     The ONE documented figure is "target under 200 lines per CLAUDE.md
  //     file" (code.claude.com/docs/en/memory § Write effective instructions)
  //     — a SOFT guideline about a gradient, NOT a truncation point ("CLAUDE.md
  //     files are loaded in full regardless of length").
  //
  //     Budgets differ by LOAD CLASS because that is the docs' own cost model
  //     — what matters is WHEN the bytes are spent:
  //       eager (root CLAUDE.md + @import closure; .claude/CLAUDE.md; unscoped
  //         .claude/rules/*, at "the same priority as .claude/CLAUDE.md") → 200
  //       lazy  (nested CLAUDE.md: "included when Claude reads files in those
  //         subdirectories", not re-injected on /compact)                 → 400
  //       cond  (paths:-scoped rules: load "only when Claude works with
  //         matching files")                                              → 400
  //       skill (SKILL.md: "Keep under 500 lines")                        → 500,
  //         plus description ≤ 1536 chars — a REAL hard truncation that
  //         silently strips the keywords Claude matches on.
  //     The byte ceilings are SELF-IMPOSED anti-gaming backstops, sized never
  //     to bind before the documented line limit. Do not re-attribute them
  //     upstream: the ≤12,000-char figure is WINDSURF's (agnix AGM-003), and
  //     citing it as Anthropic's is the error this step replaced.
  //
  //     Logic lives in kb_setup.md_budget (zero-bash) — the SHARED engine
  //     dotfiles also consumes, on the kb_setup.currency precedent.
  ["md_size_budget"] = new Step {
    check = "uv run kb-setup md-budget"
  }
  //     skill_lint — a SKILL.md may not instruct a command a mise task owns.
  //     Ray's standing directive ("skills call mise tasks that wrap the python
  //     library"), tracked as #128, which had lived ONLY in prose. This repo's
  //     own doctrine (mise-tasks-only.md) says markdown alone is "relying on
  //     the LLM" and must never be the only layer — so here is the layer.
  //
  //     It is ~80 lines because it REUSES kb_setup.hook_guard.decide: the
  //     PreToolUse guard (runtime) and this lint (authoring time) are two
  //     consumers of ONE redirect table. A second table would drift, and a
  //     test pins the shared identity. It runs unglobbed like md_size_budget:
  //     6 files, and a gate scoped so narrowly it never fires is the failure
  //     mode #214 records.
  ["skill_lint"] = new Step {
    check = "uv run kb-setup skill-lint"
  }
  // ⚠️ POSITION IS LOAD-BEARING — this step is LAST on purpose, not by accident,
  //     and moving it back beside `ruff` costs ~190 ms on every run. Do not
  //     "tidy" the two ruff steps back together.
  //
  //     `exclusive` is a WHOLE-PIPELINE barrier, not a per-step one: hk drains
  //     everything declared before it, runs this step alone, then starts
  //     everything declared after it. At its old position (15 of 20) that split
  //     the run into THREE phases and stranded five unrelated steps — ty,
  //     no_lint_skip, agnix, md_size_budget, skill_lint — behind a 40 ms task
  //     that was itself waiting on a 1,546 ms one. Declared last, the barrier
  //     drains a pipeline with nothing left behind it, and the run is two phases.
  //
  //     MEASURED 2026-08-19 from hk's own `--format json` on one host. Old
  //     position: mean 1999 ms (n=8, range 1908-2090, median 1994). This
  //     position: mean 1832 ms (n=10, range 1750-1993, median 1817). Barrier
  //     DELETED outright: mean 1799 ms (n=3) — inside the ~150 ms noise floor
  //     of the move, which is the evidence that the POSITION carried the cost
  //     and the barrier itself is nearly free. Hence the barrier stays.
  //
  //     Effect is ~167 ms of mean (~8%), and the DISTRIBUTIONS OVERLAP at the
  //     tails: a confirmation batch on the committed config produced a 1993 ms
  //     run, inside the old range. An earlier draft of this comment claimed
  //     "every after-run beat every before-run, no overlap across 13 runs" —
  //     true of those 13 runs and it did not replicate, so it is corrected here
  //     rather than left standing. **One run cannot demonstrate this change.**
  //     Compare medians over n>=5 per arm, or you are reading the noise floor.
  //
  //     Ordering is preserved: `ruff check --fix` still precedes `ruff format`
  //     per Astral's docs, because declaration order still determines it. And
  //     this is deliberately NOT `depends = ["ruff"]`, which would express the
  //     dependency exactly and buys ~10 ms more — inside the noise. The ban on
  //     `depends` is a standing decision (Ray, 2026-07-31), kept after upstream
  //     fixed the deadlock in v1.53.0 because the doctrine spans both repos and
  //     dotfiles machine-enforces it. A 10 ms gain is not a reason to split them.
  ["ruff_format"] = new Step {
    glob = pyGlob
    check = "uv run ruff format --check {{files}}"
    fix = "uv run ruff format {{files}}"
    exclusive = true
  }
}

hooks {
  ["check"] {
    steps = lintSteps
  }
  ["fix"] {
    fix = true
    steps = lintSteps
  }
  ["pre-commit"] {
    fix = true
    steps = lintSteps
  }
  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
    }
  }
}
