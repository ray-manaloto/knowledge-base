{
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -C \"${CLAUDE_PROJECT_DIR:-.}\" -- graphify hook-guard search",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PROJECT_DIR:-.}/python\" kb-setup hookguard",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -C \"${CLAUDE_PROJECT_DIR:-.}\" -- graphify hook-guard read",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "mise run -C \"${CLAUDE_PROJECT_DIR:-.}\" kb-currency-check",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise run -C \"${CLAUDE_PROJECT_DIR:-.}\" brain-transcript-audit -- --output .agent/brain-audit.md",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "mise run -C \"${CLAUDE_PROJECT_DIR:-.}\" kb-session-reflect -- --quiet",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "fable-orchestrator@fable-orchestrator": true,
    "antigravity@antigravity-for-claude-code": true,
    "astral@astral-sh": true,
    "mattpocock-skills@mattpocock": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "mise@brentmitchell25": true,
    "plugin-eval@claude-code-workflows": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "fable-orchestrator": {
      "source": {
        "source": "github",
        "repo": "mar3co/fable-orchestrator"
      }
    },
    "antigravity-for-claude-code": {
      "source": {
        "source": "github",
        "repo": "yuting0624/antigravity-for-claude-code"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "teammateMode": "auto"
}
