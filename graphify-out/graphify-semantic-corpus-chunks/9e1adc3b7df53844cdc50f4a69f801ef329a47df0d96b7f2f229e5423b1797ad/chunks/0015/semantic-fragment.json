it graphify-out/)","rationale":"graphify-out/ is meant to be committed so everyone starts with the map; manifest.json is mtime-based and breaks after clone, cost.json is local-only","source_file":"docs/translations/README.uk-UA.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_uk_ua_penpax","label":"Penpax","rationale":"Built for people whose work is scattered across hundreds of conversations and documents; on-device, no cloud","source_file":"docs/translations/README.uk-UA.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_uk_ua_contributing","label":"Contributing & Dev Setup","rationale":"Worked examples are the most useful contribution; the macOS test note exists because sample.f90 and sample.F90 collide on case-insensitive HFS+/APFS","source_file":"docs/translations/README.uk-UA.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_uz_uz","label":"README (Uzbek, uz-UZ)","rationale":"Localized copy of an earlier (v4-era) root README","source_file":"docs/translations/README.uz-UZ.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_uz_uz_three_stage_pipeline","label":"Three-Stage Extraction Pipeline","rationale":null,"source_file":"docs/translations/README.uz-UZ.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_uz_uz_ast_stage","label":"Deterministic AST Stage","rationale":"Runs without any LLM so code structure extraction is deterministic and free","source_file":"docs/translations/README.uz-UZ.md","source_location":null,"source_url":null},{"author":null,"captured_at":nu