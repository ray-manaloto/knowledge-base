6-05-04-incremental-updates-dedup-design.md","source_location":"Pipeline section mirrors AST + semantic LLM passes","target":"docs_translations_readme_ar_sa_three_pass_pipeline","weight":1},{"confidence":"AMBIGUOUS","confidence_score":0.5,"relation":"conceptually_related_to","source":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_cluster","source_file":"docs/translations/README.ar-SA.md","source_location":"Leiden clustering described in README","target":"docs_translations_readme_ar_sa_graphify","weight":0.6}],"hyperedges":[{"confidence":"EXTRACTED","confidence_score":0.95,"id":"dedup_pipeline_stages","label":"Entity dedup pipeline: normalize -> entropy gate -> LSH -> Jaro-Winkler -> community boost -> union-find","nodes":["docs_superpowers_plans_2026_05_04_incremental_updates_dedup_norm","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_entropy","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_minhash_lsh_blocking","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_jaro_winkler","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_community_boost","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_uf","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_llm_tiebreak"],"relation":"form","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md"},{"confidence":"EXTRACTED","confidence_score":0.9,"id":"incremental_extract_flow","label":"Incremental extract flow: detect -> semantic cache -> build_merge -> dedup -> cluster -> manifest","nodes":["docs_superpowers_plans_2026_05_04_incremental_updates_dedup_detect_incremental","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_check_semantic_cache","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_save_semantic_cache","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_build_merge","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_deduplicate_entities","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_cluster","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_save_manifest"],"relation":"participate_in","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md"},{"confidence":"EXTRACTED","confidence_score":0.9,"id":"release_075_artifacts","label":"Release 0.7.5 change surface","nodes":["docs_superpowers_plans_2026_05_04_incremental_updates_dedup_graphify_dedup","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_graphify_build","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_graphify_main","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_pyproject","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_tests_test_dedup","docs_superpowers_plans_2026_05_04_incremental_updates_dedup_tests_test_incremental"],"relation":"participate_in","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md"}],"nodes":[{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_plan","label":"Incremental Updates + Entity Deduplication Implementation Plan","rationale":"Two independent features wired into the same pipeline so incremental extraction and dedup ship together in one release (0.7.5).","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_superpowers_specs_2026_05_04_incremental_updates_dedup_design_design","label":"Design: Incremental Updates + Entity Deduplication","rationale":"Full-corpus re-extraction on every run is expensive for large daily-updated corpora, and chunk-by-chunk LLM extraction gives the same concept different labels across chunks.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_graphify_dedup","label":"graphify/dedup.py module","rationale":"Single-responsibility module so the dedup pipeline is isolated from graph construction and can be called from build.py.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_deduplicate_entities","label":"deduplicate_entities()","rationale":"Runs after graph construction and before cluster() because a cleaner graph yields better community detection.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_norm","label":"_norm()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_entropy","label":"_entropy() entropy gate","rationale":"Labels under 2.5 bits/char (e.g. 'AI', 'DB', 'x') are too short and ambiguous to auto-merge safely, so they skip fuzzy matching.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_shingles","label":"_shingles() k-gram shingling","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_make_minhash","label":"_make_minhash()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_uf","label":"_UF union-find","rationale":"Confirmed pairs become connected components so transitive duplicate groups collapse to a single survivor.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_pick_winner","label":"_pick_winner()","rationale":"Prefers IDs without a chunk suffix and then shorter IDs, so the canonical survivor is the least chunk-specific name.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_llm_tiebreak","label":"_llm_tiebreak()","rationale":"Ambiguous pairs are batched 30 at a time to keep cost near $0.01 for a 10k-node graph; opt-in and off by default.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_dedup_llm_flag","label":"--dedup-llm CLI flag","rationale":"Off by default because the LLM tiebreaker adds cost and nondeterminism to an otherwise deterministic pipeline.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_graphify_build","label":"graphify/build.py","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_build","label":"build()","rationale":"dedup defaults to True so entity deduplication runs on every build without a flag.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_build_merge","label":"build_merge()","rationale":"Shrink guard is skipped when dedup or prune_sources is active because the graph can then legitimately shrink.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_build_from_json","label":"build_from_json()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_deduplicate_by_label","label":"deduplicate_by_label() (dormant)","rationale":"Already written but unused — wiring it up is a free win that catches case and punctuation variants across files.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_graphify_main","label":"graphify/__main__.py extract block","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_detect","label":"detect()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_detect_incremental","label":"detect_incremental()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_save_manifest","label":"save_manifest()","rationale":"Manifest is written only on successful completion so a crash mid-run cannot corrupt the next run's diff.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_manifest_json","label":"manifest.json","rationale":null,"source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_check_semantic_cache","label":"check_semantic_cache()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_save_semantic_cache","label":"save_semantic_cache()","rationale":"Keyed by content hash so unchanged docs cost zero LLM tokens on repeat runs; on rename the cached source_file is updated to the new path.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_extract_corpus_parallel","label":"extract_corpus_parallel()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_call_llm","label":"_call_llm()","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_cluster","label":"cluster() Leiden clustering","rationale":"Always re-run on the full graph after dedup because community assignment depends on the merged topology.","source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_incremental_mode","label":"Incremental mode auto-detection","rationale":"Presence of both manifest.json and graph.json is enough to infer intent, so no flag is needed; the first run is always full.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_community_boost","label":"Same-community boost","rationale":"Leiden community structure is a strong same-entity signal that GraphRAG/LightRAG do not exploit, so shared community adds a score bonus.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_minhash_lsh_blocking","label":"MinHash + LSH blocking","rationale":"Generates candidate pairs in O(n) instead of O(n^2), keeping the pass sub-second at 10k nodes.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_jaro_winkler","label":"Jaro-Winkler verification","rationale":"Threshold of 0.92 catches typos, plurals and spacing variants while discarding weaker pairs.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_datasketch","label":"datasketch dependency","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_rapidfuzz","label":"rapidfuzz dependency","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_no_embed_nongoal","label":"Non-goal: --dedup embed (MiniLM cosine)","rationale":"Explicitly excluded to avoid a PyTorch / sentence-transformers dependency.","source_file":"docs/superpowers/specs/2026-05-04-incremental-updates-dedup-design.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_tests_test_dedup","label":"tests/test_dedup.py","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_tests_test_incremental","label":"tests/test_incremental.py","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"code","id":"docs_superpowers_plans_2026_05_04_incremental_updates_dedup_pyproject","label":"pyproject.toml (version 0.7.5)","rationale":null,"source_file":"docs/superpowers/plans/2026-05-04-incremental-updates-dedup.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_ar_sa_graphify","label":"graphify (Arabic README)","rationale":"Clustering uses graph topology rather than embeddings because Claude-extracted semantic_similar_to edges already encode similarity, so no vector database is needed.","source_file":"docs/translations/README.ar-SA.md","source_location":null,"source_url":"https://github.com/safishamsi/graphify"},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_cs_cz_graphify","label":"graphify (Czech README)","rationale":null,"source_file":"docs/translations/README.cs-CZ.md","source_location":null,"source_url":"https://github.com/safishamsi/graphify"},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ar_sa_three_pass_pipeline","label":"Three-pass extraction pipeline (AST, Whisper, Claude sub-agents)","rationale":"Code is parsed deterministically via tree-sitter AST with no LLM, and video/audio is transcribed locally, so only documents, papers and images need LLM calls.","source_file":"docs/translations/README.ar-SA.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ar_sa_confidence_labels","label":"EXTRACTED / INFERRED / AMBIGUOUS confidence labels","rationale":"Being honest about what was found versus what was inferred is a core product claim.","source_file":"docs/translations/README.ar-SA.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ar_sa_sha256_cache","label":"SHA256 cache directory","rationale":"Re-runs process only changed files.","source_file":"docs/translations/README.ar-SA.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ar_sa_penpax","label":"Penpax","rationale":"Applies the graphify graph model continuously to an entire career rather than a single folder.","source_file":"docs/translations/README.ar-SA.md","source_location":null,"source_url":"https://safishamsi.github.io/penpax.ai"}]}
