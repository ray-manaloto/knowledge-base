nal Integrations — Docker MCP Toolkit + SQLite","rationale":null,"source_file":"docs/docker-mcp-sqlite.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_extraction_pipeline","label":"Three-Pass Extraction Pipeline","rationale":"Split into a deterministic pass and LLM passes so code structure is derived without model calls and only ambiguous/unstructured media needs an LLM.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_ast_pass","label":"Deterministic tree-sitter AST Pass","rationale":"Runs without an LLM and locally, which keeps code file contents off the model API — the stated privacy guarantee.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_whisper_transcription","label":"Local Whisper / faster-whisper Transcription","rationale":"Transcription is done locally so video and audio never leave the machine.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_claude_subagents","label":"Parallel Claude Subagents for Docs, Papers, Images","rationale":null,"source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_leiden_clustering","label":"Leiden Community Detection on NetworkX Graph","rationale":"Clustering is graph-topology based with no embeddings, because Claude-extracted semantic similarity edges are already present in the graph and therefore influence community detection directly.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_confidence_tagging","label":"EXTRACTED / INFERRED / AMBIGUOUS Confidence Tagging","rationale":"Labelling each relation keeps the graph honest about what was found in source versus guessed.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_rationale_nodes","label":"rationale_for Nodes — the \"Why\"","rationale":null,"source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_graphify_out","label":"graphify-out Artifact Set (graph.html, GRAPH_REPORT.md, graph.json, cache)","rationale":null,"source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_sha256_cache","label":"SHA256 Cache","rationale":"Re-runs process only changed files.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_token_benchmark","label":"71.5x Token Reduction Benchmark","rationale":null,"source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_hi_in_graphifyignore","label":".graphifyignore Exclusion File","rationale":"Uses the same syntax as .gitignore.","source_file":"docs/translations/README.hi-IN.md","source_location":null,"source_url":null},{"a