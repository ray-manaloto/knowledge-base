tributor":null,"file_type":"document","id":"docs_translations_readme_pl_pl_readme","label":"Graphify README (Polish)","rationale":null,"source_file":"docs/translations/README.pl-PL.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_pt_br_readme","label":"Graphify README (Brazilian Portuguese)","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_ro_ro_readme","label":"Graphify README (Romanian)","rationale":null,"source_file":"docs/translations/README.ro-RO.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_ru_ru_readme","label":"Graphify README (Russian)","rationale":null,"source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_sv_se_readme","label":"Graphify README (Swedish)","rationale":null,"source_file":"docs/translations/README.sv-SE.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_th_th_readme","label":"Graphify README (Thai)","rationale":null,"source_file":"docs/translations/README.th-TH.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_tr_tr_readme","label":"Graphify README (Turkish)","rationale":null,"source_file":"docs/translations/README.tr-TR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_graphify_skill","label":"graphify — AI coding assistant skill","rationale":"Invoked as /graphify inside an existing AI coding assistant so users get knowledge-graph structure and the 'why' behind architectural decisions without leaving their tool.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_three_pass_pipeline","label":"Three-pass extraction pipeline","rationale":"Deterministic AST work is done first without an LLM so only documents, papers, images and transcripts require model calls.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_treesitter_ast_pass","label":"Deterministic tree-sitter AST pass","rationale":"Code files are parsed locally with no LLM, which keeps code content off the model API and makes structural extraction reproducible; 25 languages are supported.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_faster_whisper_transcription","label":"Local faster-whisper video/audio transcription","rationale":"Transcription runs locally with a domain-adapted prompt derived from the corpus, so media never leaves the machine and terminology matches the corpus.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_claude_subagents","label":"Parallel Claude sub-agents","rationale":"Run in parallel over documents, papers, images and transcripts to extract concepts, relations and design rationales.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_networkx_graph","label":"Merged NetworkX graph","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_leiden_clustering","label":"Leiden community-detection clustering","rationale":"Clustering is based on graph topology rather than embeddings: Leiden finds communities by edge density and the extracted semantically_similar_to edges are already in the graph, so no separate embedding step or vector database is needed.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_confidence_labels","label":"EXTRACTED / INFERRED / AMBIGUOUS edge labels","rationale":"Every relation is labelled so the graph stays honest about what was found directly in the source versus inferred; INFERRED edges carry a confidence_score from 0.0 to 1.0.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_graph_html","label":"graph.html interactive visualisation","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_graph_json","label":"graph.json persistent queryable graph","rationale":"Persists between sessions so the corpus can be queried weeks later without re-reading the raw files.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_graph_report","label":"GRAPH_REPORT.md audit report","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_sha256_cache","label":"SHA256 cache directory","rationale":"Re-runs process only files whose content hash changed.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_graphifyignore","label":".graphifyignore exclusion file","rationale":"Uses the same syntax as .gitignore so users can exclude vendor, node_modules, dist and generated files without learning a new format.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_god_nodes","label":"God nodes (highest-degree concepts)","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_surprising_connections","label":"Surprising connections ranking","rationale":"Ranked by a composite score in which code-to-paper edges score higher, and each result ships with a natural-language why.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_suggested_questions","label":"Suggested questions (4-5 per report)","rationale":"Chosen as questions the graph is uniquely positioned to answer.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_rationale_for_nodes","label":"rationale_for nodes (the 'why')","rationale":"Docstrings and inline NOTE/IMPORTANT/HACK/WHY comments are promoted to first-class nodes so design intent is queryable.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_token_benchmark","label":"71.5x token-reduction benchmark","rationale":"Printed automatically after every run to make the per-query saving versus reading raw files measurable on a mixed corpus.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_graphifyy_package","label":"graphifyy PyPI package","rationale":"The official package is named graphifyy and the only official repo is safishamsi/graphify; other graphify* PyPI packages are unaffiliated, so the name is called out explicitly.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_platform_installers","label":"Per-platform install commands","rationale":"Each assistant (Claude Code, Codex, OpenCode, Cursor, Copilot, Aider, Kiro, Antigravity and others) gets its own install subcommand; Codex uses $graphify because it binds skills to $ rather than /.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_git_hooks","label":"Git post-commit / post-checkout hooks","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_watch_autosync","label":"--watch auto-sync mode","rationale":"Keeps the graph current automatically as code changes.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_query_command","label":"/graphify query command","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_path_command","label":"/graphify path command","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_penpax","label":"Penpax enterprise layer","rationale":"Applies the same graph continuously across a user's whole professional life rather than to a single folder.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_privacy_model","label":"Privacy model (local code + media, no telemetry)","rationale":"Only documents, papers and images are sent to the assistant's model API; code goes through local tree-sitter and media through local faster-whisper, with no telemetry or usage tracking.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_tech_stack","label":"Technical stack (NetworkX, graspologic Leiden, tree-sitter, vis.js)","rationale":null,"source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_three_pass_pipeline","label":"Трёхпроходный конвейер извлечения","rationale":"Детерминированный AST-проход выполняется первым без LLM; модель нужна только для документов, статей, изображений и транскриптов.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_treesitter_ast_pass","label":"Детерминированный tree-sitter AST-проход","rationale":"Файлы кода обрабатываются локально без LLM, поэтому код не покидает машину; поддерживается 25 языков программирования.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_faster_whisper_transcription","label":"Локальная транскрипция faster-whisper","rationale":"Транскрипция идёт локально с доменным промптом, построенным из корпуса пользователя.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_claude_subagents","label":"Параллельные Claude-субагенты","rationale":null,"source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_leiden_clustering","label":"Кластеризация Leiden без эмбеддингов","rationale":"Структура графа сама является сигналом сходства: рёбра semantically_similar_to уже в графе, поэтому отдельный шаг эмбеддингов и векторная база данных не нужны.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_confidence_labels","label":"Метки EXTRACTED / INFERRED / AMBIGUOUS","rationale":"Каждая связь помечается, чтобы граф был честен относительно найденного и выведенного; INFERRED-рёбра несут confidence_score.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_rationale_for_nodes","label":"Узлы rationale_for («почему»)","rationale":"Docstrings и комментарии NOTE/IMPORTANT/HACK/WHY извлекаются как отдельные узлы, чтобы обоснования дизайна можно было запрашивать.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_token_benchmark","label":"Бенчмарк сокращения токенов в 71,5 раза","rationale":"Выводится автоматически после каждого запуска для измеримого сравнения с чтением сырых файлов.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_graphifyy_package","label":"Пакет PyPI graphifyy","rationale":"Другие пакеты graphify* на PyPI не связаны с проектом, поэтому официальное имя указано явно.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_platform_installers","label":"Команды установки по платформам","rationale":"Codex использует $ вместо / для навыков, поэтому команда вводится как $graphify.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_graphifyignore","label":"Файл .graphifyignore","rationale":"Синтаксис аналогичен .gitignore.","source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_ru_ru_penpax","label":"Penpax — корпоративный слой","rationale":null,"source_file":"docs/translations/README.ru-RU.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_pt_br_karpathy_raw_folder","label":"Karpathy /raw folder problem","rationale":"Framed as the motivating use case: a dumping folder of papers, tweets, screenshots and notes that graphify turns into a persistent graph.","source_file":"docs/translations/README.pt-BR.md","source_location":null,"source_url":null}]}
