ranslations_readme_fa_ir_callflow_export"],"relation":"form","source_file":"docs/translations/README.fa-IR.md"},{"confidence":"EXTRACTED","confidence_score":0.9,"id":"graphify_readme_translation_set","label":"Localised README set linking to one another and the English original","nodes":["docs_translations_readme_fa_ir","docs_translations_readme_fi_fi","docs_translations_readme_fil_ph","docs_translations_readme_fr_fr"],"relation":"form","source_file":"docs/translations/README.fa-IR.md"}],"nodes":[{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fa_ir","label":"README (Persian / fa-IR)","rationale":"Persian-language translation of the project README so non-English users can install and use the skill; laid out with RTL blocks for Persian prose while code fences stay LTR.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fi_fi","label":"README (Finnish / fi-FI)","rationale":null,"source_file":"docs/translations/README.fi-FI.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fil_ph","label":"README (Filipino / fil-PH)","rationale":null,"source_file":"docs/translations/README.fil-PH.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fr_fr","label":"README (French / fr-FR)","rationale":null,"source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify","label":"graphify (AI coding-assistant skill)","rationale":"Positioned as the answer to the Karpathy `/raw` folder problem: 71.5x fewer tokens per query than reading raw files, persistent across sessions, and honest about what was found vs inferred.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_command","label":"/graphify slash command","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_install","label":"graphify install (skill registration)","rationale":"`--project` installs the skill into the current repo instead of the user profile, so a team can pin the skill per-repository.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_uninstall","label":"graphify uninstall","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphifyy_package","label":"graphifyy PyPI package","rationale":"Named with a double y because other `graphify*` packages on PyPI are unaffiliated squatters; the CLI entry point stays `graphify` so the docs read naturally.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_extras","label":"Optional install extras (pdf, office, video, mcp, neo4j, backends)","rationale":"Split into extras so users install only the dependencies they need rather than the full `all` set.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graph_html","label":"graph.html (interactive graph)","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graph_report","label":"GRAPH_REPORT.md (audit report)","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graph_json","label":"graph.json (persistent queryable graph)","rationale":"Persisted so the graph can be queried later without re-reading the source files, which is where the token savings come from.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_out","label":"graphify-out/ output directory","rationale":"Designed to be committed to git so the whole team starts from the same map; only cost.json is recommended for .gitignore, with cache/ optional as a repo-size vs speed trade-off.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_tree_sitter","label":"tree-sitter AST extraction (36 languages)","rationale":"Code is parsed locally with no API calls, so source code never leaves the machine.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_whisper_transcription","label":"Local video/audio transcription (Whisper / faster-whisper)","rationale":"Runs locally so media never leaves the user's machine.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_confidence_labels","label":"Confidence labels (EXTRACTED / INFERRED / AMBIGUOUS)","rationale":"Every relationship is labelled so the user always knows what was found versus what was guessed.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_rationale_nodes","label":"The \"why\" — rationale extracted as nodes","rationale":"Inline comments (# NOTE:, # WHY:, # HACK:), docstrings and design reasoning become separate nodes linked to the code they explain, so architectural intent is queryable.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_god_nodes","label":"God nodes / core concepts","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_surprising_connections","label":"Surprising connections","rationale":"Ranked by how unexpected the link is; code-to-paper edges score higher because cross-modal links carry the most new information.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphifyignore","label":".graphifyignore","rationale":"Reuses .gitignore syntax including `!` negation, and falls back to a directory's .gitignore when absent so users don't have to maintain two ignore files.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_mcp_server","label":"MCP server (graphify.serve)","rationale":"Exposes structured tools (query_graph, get_node, get_neighbors, shortest_path, list_prs, get_pr_impact, triage_prs); an HTTP transport with host/port and --api-key exists for shared team access.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_query","label":"graphify query","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_path","label":"graphify path","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_explain","label":"graphify explain","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_extract","label":"graphify extract (headless / CI)","rationale":"Environment-variable API keys are needed only here; when run through the /graphify skill inside an IDE the model API is supplied by the IDE session.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_env_vars","label":"Backend environment variables (ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY, ...)","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_graphify_force","label":"GRAPHIFY_FORCE / --force rebuild","rationale":"Needed because after a refactor deletes files, stale nodes survive an incremental --update; a forced rebuild clears them.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_update_flag","label":"--update incremental re-extraction","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_hook_install","label":"graphify hook install (post-commit / post-checkout)","rationale":"Keeps the committed graph fresh automatically after each commit instead of relying on people to re-run the build.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_prs_dashboard","label":"graphify prs (PR dashboard, triage, conflicts)","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_callflow_export","label":"graphify export callflow-html","rationale":"Produces a readable architecture page with Mermaid call-flow diagrams for people who want prose-and-diagram output rather than an interactive graph.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_merge_graphs","label":"graphify merge-graphs","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_privacy_model","label":"Privacy model (local code, no telemetry)","rationale":"Only docs, PDFs and images go to the model API; code and media stay local, and there is no telemetry, usage tracking, or analytics.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_penpax","label":"Penpax (always-on layer on graphify)","rationale":"Applies the same graph approach to a whole working life (meetings, browser history, email, files, code) for people whose work is scattered across hundreds of conversations; cloud-free and fully on-device.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fa_ir_contributing","label":"Contributing guide (dev setup, tests, git workflow)","rationale":"Worked examples are called the most useful contribution because they show honest real-corpus output; contributors save results in worked/{slug}/ with a candid review.md of what was right and wrong.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_v8_branch","label":"v8 development branch","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_uv_workflow","label":"uv-based development workflow","rationale":"Recommended over pip because uv and pipx put the graphify CLI on PATH automatically, avoiding the common `command not found` failure.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_pytest_suite","label":"pytest test suite (uv run pytest tests/)","rationale":"Must pass before opening a PR.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fa_ir_architecture_doc","label":"ARCHITECTURE.md","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fa_ir_how_it_works_doc","label":"docs/how-it-works.md","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"document","id":"docs_translations_readme_fa_ir_docker_mcp_sqlite_doc","label":"docs/docker-mcp-sqlite.md (optional integrations)","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_three_pass_pipeline","label":"Three-pass extraction pipeline","rationale":"Deterministic AST pass first (no LLM), then local faster-whisper transcription, then Claude sub-agents in parallel over docs/papers/images/transcripts — keeping the cheap deterministic work off the model API.","source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_networkx_graph","label":"NetworkX merged graph","rationale":null,"source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_leiden_clustering","label":"Leiden community-detection clustering","rationale":"Clustering is topology-based with no embeddings: Leiden finds communities by edge density, and the Claude-extracted semantically_similar_to edges already carry the similarity signal, so no separate embedding step or vector database is needed.","source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_claude_subagents","label":"Claude sub-agents (parallel semantic extraction)","rationale":null,"source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_tech_stack","label":"Tech stack (NetworkX + Leiden/graspologic + tree-sitter + vis.js)","rationale":null,"source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_semantically_similar_to_edge","label":"semantically_similar_to edge (INFERRED)","rationale":null,"source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_sha256_cache","label":"SHA256 cache directory","rationale":"Re-runs only process changed files.","source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fr_fr_watch_mode","label":"--watch auto-sync mode","rationale":null,"source_file":"docs/translations/README.fr-FR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_token_benchmark","label":"71.5x token-reduction benchmark","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_karpathy_raw_folder","label":"Karpathy's /raw folder problem","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_platform_matrix","label":"AI assistant platform support matrix","rationale":null,"source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_powershell_note","label":"PowerShell leading-slash caveat","rationale":"PowerShell treats a leading `/` as a path separator, so Windows users must type `graphify .` without the slash.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null},{"author":null,"captured_at":null,"contributor":null,"file_type":"concept","id":"docs_translations_readme_fa_ir_team_workflow","label":"Team setup workflow","rationale":"One person builds and commits graphify-out/, everyone else pulls and their assistant reads the graph immediately — so the graph build cost is paid once per team.","source_file":"docs/translations/README.fa-IR.md","source_location":null,"source_url":null}]}
